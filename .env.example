# Copy to .env and fill in. Never commit real secrets.

# --- Postgres (local docker-compose) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockpredict
SPRING_DATASOURCE_USERNAME=stockpredict
SPRING_DATASOURCE_PASSWORD=stockpredict

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- Auth service JWT (RS256) ---
STOCKPREDICT_JWT_ISSUER=https://auth.stockpredict.local
STOCKPREDICT_JWT_AUDIENCE=stockpredict-api
# Paths are resolved inside the service working directory.
AUTH_JWT_PRIVATE_KEY_PATH=config/keys/dev-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=config/keys/dev-public.pem
AUTH_JWT_KEY_ID=dev-2026-01

# --- Market data providers (server-side only; never exposed to clients) ---
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
